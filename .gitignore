# data: raw and processed sources are never tracked
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/

# model and pipeline artifacts
outputs/models/*
!outputs/models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# experiment tracking
mlruns/
.mlruns/

# python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# virtual environments
.venv/
.venv*/
venv/
env/

# jupyter
.ipynb_checkpoints/

# os and editor
.DS_Store
.idea/
.vscode/
