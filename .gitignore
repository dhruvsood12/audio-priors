# data: raw and processed sources are never tracked
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/

# model and pipeline artifacts
outputs/models/*
!outputs/models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
# Documentation artifacts referenced from README.md and MODEL.md. They are
# regenerable via `make train` + `make interpret`; tracking them keeps the
# GitHub landing page from showing broken-image icons and 404s.
!outputs/figures/demo.png
!outputs/figures/07_shap_bar.png
!outputs/figures/10_calibration.png
outputs/tables/*
!outputs/tables/.gitkeep
!outputs/tables/metrics.csv
!outputs/tables/per_genre_auc.csv
!outputs/tables/split_delta.csv
!outputs/tables/legacy_metrics.csv

# experiment tracking
mlruns/
.mlruns/

# python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# virtual environments
.venv/
.venv*/
venv/
env/

# jupyter
.ipynb_checkpoints/

# os and editor
.DS_Store
.idea/
.vscode/
